<view class="app" style="{{varsStyle}}" bindtap="onPageTap">
  <!-- 顶部加载进度条 -->
  <view class="progress {{progressState}}"></view>

  <!-- 点缀：山峦（CSS clip-path 简化版，跟随主题色） -->
  <view class="deco-mountains">
    <view class="mountain far"></view>
    <view class="mountain near"></view>
  </view>

  <!-- 开屏动画（与网页版一致：2.6s 自动消失，点击可跳过） -->
  <view wx:if="{{splashShow}}" class="splash" catchtap="onTapSplash">
    <view class="splash-box">
      <image class="splash-logo" src="/assets/logo-yang.png" mode="aspectFit"></image>
      <view class="splash-rule"></view>
      <view class="splash-motto">
        <text wx:for="{{mottoChars}}" wx:key="index" class="ch {{item === '·' ? 'mid' : ''}}" style="--i: {{index}}">{{item}}</text>
      </view>
      <view class="splash-note">非营利项目 · 数据源自开源社区 · 仅供学习欣赏</view>
    </view>
  </view>

  <view class="page">
    <view class="header">
      <image class="site-logo" src="/assets/logo-yang.png" mode="aspectFit"></image>
    </view>
    <view class="subtitle">在线诗词浏览器 · {{libTip}}</view>
    <view class="search-tip">三个条件框均可留空：全部留空将随机推荐一首，填写任意一项即按条件搜索</view>
    <view class="data-note">提示：个别文字显示为「□」是原始古籍数据缺损或字体未收录所致，属正常现象，并非程序错误</view>

    <view class="controls">
      <view class="row">
        <view class="field">
          <view class="label">作者</view>
          <input class="input" placeholder="例如：李白" placeholder-class="ph" value="{{author}}" bindinput="onAuthorInput" />
        </view>
        <view class="field">
          <view class="label">朝代</view>
          <input class="input" placeholder="例如：唐" placeholder-class="ph" value="{{dynasty}}" bindinput="onDynastyInput" />
        </view>
        <view class="field type-wrap">
          <view class="label">体裁</view>
          <view class="input type-field" catchtap="onTypeFieldTap">
            <text wx:if="{{type}}">{{type}}</text>
            <text wx:else class="ph">点击选择体裁</text>
            <text class="type-caret {{typeDropdownShow ? 'up' : ''}}">▾</text>
          </view>
        </view>
      </view>
      <!-- 体裁选择面板：整行内联展开（推挤布局，任何机型都稳定显示） -->
      <view wx:if="{{typeDropdownShow}}" class="type-panel" catchtap="noop" catchtouchmove="noop">
        <input class="input dd-search" placeholder="搜索体裁，如：绝句" placeholder-class="ph" value="{{typeQuery}}" bindinput="onTypeQuery" />
        <scroll-view class="dd-list" scroll-y>
          <view class="type-grid">
            <view wx:for="{{typeOptionsShown}}" wx:key="*this"
              class="type-tag {{(item === '无' && !type) || item === type ? 'active' : ''}}" data-value="{{item}}" bindtap="onTypeOptTap">{{item}}</view>
          </view>
        </scroll-view>
      </view>
      <view class="btn-row">
        <button class="btn primary" disabled="{{randomLoading}}" bindtap="onRandomTap">
          <block wx:if="{{randomLoading}}">正在读取……</block>
          <block wx:else><text class="btn-line" wx:for="{{randomBtnLines}}" wx:key="index">{{item}}</text></block>
        </button>
      </view>
      <view class="random-tip">{{randomTip}}</view>
    </view>

    <view wx:if="{{!listMode}}" class="card">
      <view class="card-frame"></view>
      <text class="card-watermark">詩</text>
      <block wx:if="{{hasPoem}}">
        <view class="card-fav {{currentFav ? 'on' : ''}} {{favBurst ? 'burst' : ''}}" catchtap="onCardFavTap"><view class="star-glyph"></view></view>
        <view class="card-note {{currentNote ? 'on' : ''}}" catchtap="onCardNoteTap"><view class="note-glyph"></view></view>
        <view class="card-body">
          <view class="title" style="{{titleStyle}}">
            <view wx:for="{{titleLines}}" wx:key="index" class="title-line">{{item}}</view>
          </view>
          <view class="meta" style="{{metaStyle}}">{{poem.meta}}</view>
          <view class="content {{isVertical ? 'vertical' : ''}}">
            <view wx:for="{{verseLines}}" wx:key="index" class="verse-line {{item.wrap ? 'wrap' : ''}}">
              <text>{{item.text}}</text><text wx:if="{{item.punct}}" class="hang-punct">{{item.punct}}</text>
            </view>
          </view>
          <view wx:if="{{poem.type}}" class="category" style="{{categoryStyle}}">体裁：{{poem.type}}</view>
        </view>
        <view class="card-tools">
          <button class="btn secondary" disabled="{{shareLoading}}" bindtap="onShareTap">
            <block wx:if="{{shareLoading}}">生成中……</block>
            <block wx:else><text class="btn-line" wx:for="{{shareBtnLines}}" wx:key="index">{{item}}</text></block>
          </button>
          <view class="ratio-row">
            <text class="ratio-label">卡片比例</text>
            <view class="ratio-seg">
              <view class="ratio-thumb" style="left: calc({{ratioActiveIndex * 25}}% + 4rpx)"></view>
              <view wx:for="{{ratioOptions}}" wx:key="value"
                class="ratio-seg-item {{item.active ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}"
                data-value="{{item.value}}" bindtap="onRatioTap">{{item.label}}</view>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="status {{statusError ? 'error' : ''}}">{{statusText}}</view>
    </view>

    <!-- 搜索结果列表：就地替换诗词卡片（再随机单首时换回卡片）；页面触底自动翻页 -->
    <view wx:if="{{listMode}}" class="results-panel">
      <view class="results-head">
        <view class="results-head-l">
          <text class="results-title">匹配结果</text>
          <text class="results-count">{{resultsDone ? ' · 共 ' + resultsCount + ' 首' : ' · 已加载 ' + resultsCount + ' 首'}}</text>
        </view>
        <view class="results-head-r">
          <block wx:if="{{!selMode}}">
            <view class="mini-btn" bindtap="onSelModeEnter">批量收藏</view>
            <view class="mini-btn solid" bindtap="onListModeExit">返回</view>
          </block>
          <block wx:else>
            <view class="mini-btn" bindtap="onSelAll">{{selCount >= resultsList.length && resultsList.length ? '取消全选' : '全选'}}</view>
            <view class="mini-btn accent {{selCount ? '' : 'disabled'}}" bindtap="onSelFav">收藏所选({{selCount}})</view>
            <view class="mini-btn" bindtap="onSelModeExit">取消</view>
          </block>
        </view>
      </view>
      <view class="results-note">提示：个别文字显示为「□」是原始古籍数据缺损或字体未收录所致，属正常现象，并非程序错误</view>
      <view wx:for="{{resultsList}}" wx:key="id" class="result-item {{item.open ? 'open' : ''}}">
        <view class="result-head" data-index="{{index}}" bindtap="onResultItemTap">
          <view wx:if="{{selMode}}" class="chk {{selIds[item.id] ? 'on' : ''}}">✓</view>
          <view class="result-hm">
            <view class="result-t">{{item.t || '无题'}}</view>
            <view class="result-m">{{item.d}} · {{item.a}}{{item.y ? ' · ' + item.y : ''}}</view>
          </view>
          <view wx:if="{{!selMode}}" class="result-note {{item.hasNote ? 'on' : ''}}" data-index="{{index}}" catchtap="onResultNoteTap"><view class="note-glyph"></view></view>
          <view wx:if="{{!selMode}}" class="result-fav {{item.fav ? 'on' : ''}} {{item.burst ? 'burst' : ''}}" data-index="{{index}}" catchtap="onResultFavTap"><view class="star-glyph"></view></view>
          <view class="result-arrow {{item.open ? 'open' : ''}}">▾</view>
        </view>
        <view class="result-body-wrap {{item.open ? 'open' : ''}}">
        <view class="result-body">
          <view class="result-verse">{{item.c}}</view>
          <view class="result-tools">
            <view class="ratio-row">
              <text class="ratio-label">卡片比例</text>
              <view class="ratio-seg">
                <view class="ratio-thumb" style="left: calc({{ratioActiveIndex * 25}}% + 4rpx)"></view>
                <view wx:for="{{ratioOptions}}" wx:for-item="r" wx:key="value"
                  class="ratio-seg-item {{r.active ? 'active' : ''}} {{r.disabled ? 'disabled' : ''}}"
                  data-value="{{r.value}}" bindtap="onRatioTap">{{r.label}}</view>
              </view>
            </view>
            <button class="btn secondary result-share" data-index="{{index}}" catchtap="onResultShareTap">
              <block wx:if="{{shareLoading}}">生成中……</block>
              <block wx:else>下载或分享卡片</block>
            </button>
          </view>
        </view>
        </view>
      </view>
      <view class="results-foot">
        <block wx:if="{{resultsLoading}}">正在加载……</block>
        <block wx:elif="{{resultsDone}}">已全部加载 · 共 {{resultsCount}} 首</block>
        <block wx:else>上滑自动加载更多</block>
      </view>
    </view>

    <view class="site-footer">
      <image class="footer-logo" src="/assets/logo-yin.png" mode="aspectFit"></image>
      <view class="slogan">诗海 · 非营利古诗词共享项目</view>
      <view class="copyright" bindlongpress="onDevEntry">版权所有 © Ethan 2026 · 非营利项目</view>
      <view class="copyright">数据来源：chinese-poetry 开源项目（MIT License）</view>
    </view>
  </view>

  <!-- 收藏夹入口（设置图标旁） -->
  <view class="guide-toggle {{uiReady ? 'ready' : ''}}" catchtap="onGuideOpen">
    <view class="guide-icon"></view>
  </view>
  <view class="fav-toggle {{uiReady ? 'ready' : ''}}" catchtap="onFavToggle">
    <view class="fav-icon"></view>
  </view>
  <view class="note-toggle {{uiReady ? 'ready' : ''}}" catchtap="onNoteToggle">
    <view class="note-icon"></view>
  </view>

  <!-- 主题设置按钮 -->
  <!-- 设置图标：纯色齿轮（跟随主题文字色），点击绕中心旋转 -->
  <view class="theme-toggle {{uiReady ? 'ready' : ''}} {{gearSpin ? 'spin' : ''}}" catchtap="onThemeToggle"
    bindtouchstart="onGearTouchStart" bindtouchend="onGearTouchEnd" bindtouchcancel="onGearTouchEnd" bindtouchmove="onGearTouchMove">
    <view class="gear-icon"></view>
  </view>

  <!-- 主题面板（配色/文字方向，与网页版一致） -->
  <view class="theme-panel {{themePanelOpen ? 'open' : ''}}" catchtap="noop" catchtouchmove="noop">
    <view class="theme-section">
      <view class="theme-label">配色</view>
      <view class="theme-options">
        <view wx:for="{{colorOptions}}" wx:key="value" class="theme-opt {{item.active ? 'active' : ''}}"
          data-group="color" data-value="{{item.value}}" bindtap="onThemeOptTap">{{item.label}}</view>
      </view>
    </view>
    <view class="theme-section">
      <view class="theme-label">文字方向</view>
      <view class="theme-options">
        <view wx:for="{{directionOptions}}" wx:key="value" class="theme-opt {{item.active ? 'active' : ''}}"
          data-group="direction" data-value="{{item.value}}" bindtap="onThemeOptTap">{{item.label}}</view>
      </view>
    </view>
    <view class="theme-section">
      <view class="theme-label">批注卡片提醒</view>
      <view class="theme-options">
        <view class="theme-opt {{notePromptOn ? 'active' : ''}}" data-value="on" bindtap="onNotePromptTap">开</view>
        <view class="theme-opt {{notePromptOn ? '' : 'active'}}" data-value="off" bindtap="onNotePromptTap">关</view>
      </view>
    </view>
    <view class="panel-hint">点击页面空白处即可关闭</view>
  </view>

  <!-- 首次使用提示（确认一次后不再显示） -->
  <view wx:if="{{disclaimerShow}}" class="disclaimer" catchtap="noop" catchtouchmove="noop">
    <view class="disclaimer-sheet">
      <image class="disclaimer-seal" src="/assets/logo-yin.png" mode="aspectFit"></image>
      <view class="disclaimer-title">使用提示</view>
      <view class="disclaimer-item"><text class="di-ico">📚</text><view class="di-text"><text class="di-t">数据来源</text>诗词数据来自开源 chinese-poetry 项目，经本项目重新整理、索引与字符清理。</view></view>
      <view class="disclaimer-item"><text class="di-ico">🔍</text><view class="di-text"><text class="di-t">版本差异</text>古籍版本与整理方式不同，内容或与其他版本有出入，仅供参考。</view></view>
      <view class="disclaimer-item"><text class="di-ico">🕊️</text><view class="di-text"><text class="di-t">非营利用途</text>仅供阅读、学习与研究欣赏。</view></view>
      <button class="btn primary disclaimer-ok" catchtap="onDismissDisclaimer">同意</button>
    </view>
  </view>

  <!-- 开发者面板：长按设置齿轮 5s 呼出 -->
  <view wx:if="{{devShow}}" class="dev-mask" catchtap="noop" catchtouchmove="noop">
    <view class="dev-sheet" catchtap="noop">
      <view class="dev-title">🛠 开发者面板</view>
      <scroll-view scroll-y class="dev-list">
        <block wx:for="{{devRows}}" wx:key="id">
          <view wx:if="{{item.sec}}" class="dev-sec">{{item.sec}}</view>
          <view wx:else class="dev-row">
            <text class="dev-k">{{item.k}}</text>
            <text class="dev-v">{{item.v}}</text>
          </view>
        </block>
      </scroll-view>
      <button class="btn primary dev-btn" catchtap="onDevCopy">复制全部信息</button>
      <button class="btn secondary dev-btn" catchtap="onDevReshowDisclaimer">重新显示开屏使用提示</button>
      <button class="btn secondary dev-btn" catchtap="onDevClose">关闭面板</button>
    </view>
  </view>

  <!-- 收藏夹抽屉：批量管理/删除；收藏仅存本机缓存 -->
  <!-- 使用指南（顶部灯泡图标呼出） -->
  <view wx:if="{{guideShow}}" class="picker-mask" catchtouchmove="noop" bindtap="onGuideClose">
    <view class="guide-box" catchtap="noop">
      <view class="sheet-head">使用指南</view>
      <view class="guide-list">
        <view class="guide-item"><text class="guide-k">随机邂逅</text>不填任何条件，点「今日与诗相逢」<text class="guide-b">随机推荐一首</text>。</view>
        <view class="guide-item"><text class="guide-k">条件搜索</text>填写作者 / 朝代 / 体裁<text class="guide-b">任意组合</text>；体裁点输入框展开选择，首项「无」表示不限。</view>
        <view class="guide-item"><text class="guide-k">列表浏览</text>点击标题行<text class="guide-b">展开全诗</text>，一次只展开一首；<text class="guide-b">上滑自动加载更多</text>。</view>
        <view class="guide-item"><text class="guide-k">批量收藏</text>列表中点「批量收藏」，勾选后<text class="guide-b">一键加入收藏夹</text>。</view>
        <view class="guide-item"><text class="guide-k">收藏</text>点诗词旁的<text class="guide-b">星星</text>收藏，星星会绽放成红色；右上角星标按钮打开收藏夹，支持<text class="guide-b">批量管理与删除</text>。</view>
        <view class="guide-item"><text class="guide-k">批注</text>点诗词旁的<text class="guide-b">纸笔图标</text>写下感悟；右上角纸笔按钮打开批注本，支持<text class="guide-b">批量管理与删除</text>；批注可生成「批注大、诗词小」的分享卡片，<text class="guide-b">生成时再选比例</text>。</view>
        <view class="guide-item"><text class="guide-k">分享卡片</text>在卡片内选择比例后点<text class="guide-b">「下载或分享卡片」</text>，生成高清图片保存或转发。</view>
        <view class="guide-item"><text class="guide-k">主题排版</text>右上角<text class="guide-b">齿轮</text>可切换主题配色、横竖排版与字号版式。</view>
        <view class="guide-item"><text class="guide-k">缺字说明</text>个别文字显示为<text class="guide-b">「□」</text>，是原始古籍数据缺损或字体未收录所致，<text class="guide-b">属正常现象，并非程序错误</text>。</view>
        <view class="guide-item"><text class="guide-k">温馨提示</text>收藏与批注仅保存在本机<text class="guide-b">本地缓存</text>（相当于 cookie），清除缓存或卸载后会丢失，心仪的诗词与感悟请<text class="guide-b">及时生成卡片保存</text>。</view>
      </view>
      <button class="btn primary guide-ok" bindtap="onGuideClose">我知道了</button>
    </view>
  </view>
  <view wx:if="{{favSheetShow}}" class="picker-mask" catchtouchmove="noop" bindtap="onFavSheetClose">
    <view class="fav-sheet" catchtap="noop">
      <view class="sheet-head">收藏夹<text class="results-count"> · {{favList.length}} 首</text></view>
      <view class="fav-tip">★ 收藏仅保存在本机本地缓存（相当于浏览器 cookie），清除缓存或卸载小程序后会丢失</view>
      <view class="fav-bar">
        <view class="mini-btn" bindtap="onFavManage">{{favSelMode ? '完成' : '批量管理'}}</view>
        <block wx:if="{{favSelMode}}">
          <view class="mini-btn" bindtap="onFavSelAll">{{favSelCount >= favList.length && favList.length ? '取消全选' : '全选'}}</view>
          <view class="mini-btn danger {{favSelCount ? '' : 'disabled'}}" bindtap="onFavDelete">删除所选({{favSelCount}})</view>
        </block>
      </view>
      <scroll-view class="fav-list" scroll-y>
        <view wx:if="{{!favList.length}}" class="sheet-empty">还没有收藏 · 在诗词右上角点 ☆ 即可收藏到这里</view>
        <view wx:for="{{favList}}" wx:key="id" class="fav-item" data-index="{{index}}" bindtap="onFavItemTap">
          <view wx:if="{{favSelMode}}" class="chk {{favSelIds[item.id] ? 'on' : ''}}">✓</view>
          <view class="result-hm">
            <view class="result-t">{{item.t || '无题'}}</view>
            <view class="result-m">{{item.d}} · {{item.a}}{{item.y ? ' · ' + item.y : ''}}</view>
          </view>
          <view class="fav-heart"><view class="star-glyph"></view></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 批注编辑器（纸笔图标；批注卡片比例四档可选） -->
  <view wx:if="{{noteEditShow}}" class="picker-mask" catchtouchmove="noop" bindtap="onNoteEditClose">
    <view class="note-edit-box" catchtap="noop">
      <view class="sheet-head">{{noteEditTitle}}</view>
      <view class="note-edit-meta">{{noteEditMeta}}</view>
      <textarea class="note-textarea" value="{{noteText}}" maxlength="120" placeholder="写下此刻的感悟……（120 字以内）" bindinput="onNoteInput" auto-height></textarea>
      <view class="note-edit-bar">
        <view wx:if="{{noteEditHas}}" class="mini-btn danger" bindtap="onNoteRemove">删除批注</view>
        <view class="note-edit-spacer"></view>
        <view class="mini-btn" bindtap="onNoteEditClose">取消</view>
        <view class="mini-btn solid" bindtap="onNoteSave">保存</view>
      </view>
    </view>
  </view>

  <!-- 批注本：批量管理 / 生成卡片 -->
  <view wx:if="{{noteSheetShow}}" class="picker-mask" catchtouchmove="noop" bindtap="onNoteSheetClose">
    <view class="fav-sheet" catchtap="noop">
      <view class="sheet-head">批注本<text class="results-count"> · {{noteListData.length}} 条</text></view>
      <view class="fav-tip">✎ 批注仅保存在本机本地缓存（相当于 cookie），清除缓存或卸载小程序后会丢失</view>
      <view class="fav-bar">
        <view class="mini-btn" bindtap="onNoteManage">{{noteSelMode ? '完成' : '批量管理'}}</view>
        <block wx:if="{{noteSelMode}}">
          <view class="mini-btn" bindtap="onNoteSelAll">{{noteSelCount >= noteListData.length && noteListData.length ? '取消全选' : '全选'}}</view>
          <view class="mini-btn danger {{noteSelCount ? '' : 'disabled'}}" bindtap="onNoteDelete">删除所选({{noteSelCount}})</view>
        </block>
      </view>
      <scroll-view class="fav-list" scroll-y>
        <view wx:if="{{!noteListData.length}}" class="sheet-empty">还没有批注 · 在诗词右上角点 ✎ 即可写下感悟</view>
        <view wx:for="{{noteListData}}" wx:key="id" class="note-item" data-index="{{index}}" bindtap="onNoteItemTap">
          <view wx:if="{{noteSelMode}}" class="chk {{noteSelIds[item.id] ? 'on' : ''}}">✓</view>
          <view class="note-body">
            <view class="note-text">{{item.n}}</view>
            <view class="result-m note-date">《{{item.t || '无题'}}》{{item.d}} · {{item.a}} · {{item.date}}</view>
          </view>
          <view wx:if="{{!noteSelMode}}" class="note-card-btn" data-index="{{index}}" catchtap="onNoteItemCard">生成卡片</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 保存批注后：询问是否生成卡片（可勾选「不再询问」） -->
  <view wx:if="{{noteAskShow}}" class="picker-mask" catchtouchmove="noop" bindtap="onNoteAskNo">
    <view class="note-ask-box" catchtap="noop">
      <view class="sheet-head">生成批注卡片？</view>
      <view class="note-ask-tip">批注已保存。可将批注与诗词同框生成分享卡片（批注大、诗词小），便于保存与转发。勾选「记住选择」后不再询问；也可在设置 →「批注卡片提醒」中选择关闭。</view>
      <view class="note-ask-remember" bindtap="onNoteAskRememberToggle">
        <view class="chk {{noteAskRemember ? 'on' : ''}}">✓</view>
        <text>记住选择，以后不再询问</text>
      </view>
      <view class="note-ask-bar">
        <view class="mini-btn" bindtap="onNoteAskNo">暂不</view>
        <view class="mini-btn solid" bindtap="onNoteAskYes">生成卡片</view>
      </view>
    </view>
  </view>

  <!-- 生成批注卡片前：选择比例（编辑器内不再选比例） -->
  <view wx:if="{{noteRatioShow}}" class="picker-mask" catchtouchmove="noop" bindtap="onNoteRatioClose">
    <view class="note-ask-box" catchtap="noop">
      <view class="sheet-head">选择卡片比例</view>
      <view wx:if="{{noteRatioAuto}}" class="note-ask-tip">已按你的设置，保存批注后自动生成卡片；如需调整，可在设置 →「批注卡片提醒」中修改。</view>
      <view class="note-ask-tip">将生成「批注大、诗词小」的分享卡片，选一个喜欢的比例吧。</view>
      <view class="ratio-seg">
        <view class="ratio-thumb" style="left: calc({{noteRatioIndex * 25}}% + 4rpx)"></view>
        <view wx:for="{{noteRatioOptions}}" wx:key="value" class="ratio-seg-item {{item.active ? 'active' : ''}}"
          data-value="{{item.value}}" bindtap="onNoteRatioTap">{{item.label}}</view>
      </view>
      <view class="note-ask-bar">
        <view class="mini-btn" bindtap="onNoteRatioClose">取消</view>
        <view class="mini-btn solid" bindtap="onNoteRatioConfirm">生成卡片</view>
      </view>
    </view>
  </view>

  <!-- 分享浮层：生成图上浮预览（圆角），下方三选项 -->
  <view wx:if="{{shareSheetShow}}" class="share-mask" bindtap="closeShareSheet">
    <view class="share-sheet" catchtap="noop">
      <image class="share-preview" src="{{shareImg}}" mode="widthFix" bindtap="previewShareImg" />
      <view class="share-actions">
        <button class="share-opt" open-type="share" bindtap="haptic"><text class="opt-ico">💬</text>分享给朋友</button>
        <button class="share-opt" bindtap="saveShare"><text class="opt-ico">🖼️</text>保存到相册</button>
      </view>
      <view class="share-tip">点图片可全屏预览 · 点空白处关闭 · 朋友圈分享：右上角「···」→ 分享到朋友圈</view>
    </view>
  </view>

  <!-- 分享图离屏画布（canvas 2d） -->
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
</view>
