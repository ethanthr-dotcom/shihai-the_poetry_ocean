/* 单页样式：镜像网页版 index.html，尺寸按 750 设计稿换算 rpx */
.app {
  min-height: 100vh;
  background: var(--bg-color, #f4f1e8);
  color: var(--text-color, #2f2a24);
  font-family: "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif;
  transition: background 0.3s, color 0.3s;
}

/* ====== 顶部加载进度条 ====== */
.progress {
  position: fixed; top: 0; left: 0; height: 6rpx; width: 0;
  background: var(--accent-color); z-index: 1001; opacity: 0;
  transition: width .35s ease, opacity .3s ease;
}
.progress.run { opacity: 1; width: 88%; transition: width 1.3s cubic-bezier(.22,.61,.36,1), opacity .2s; }
.progress.done { width: 100%; opacity: 0; transition: width .25s ease, opacity .45s ease .15s; }

/* ====== 点缀：山峦（CSS clip-path 简化版） ====== */
.deco-mountains {
  position: fixed; right: 0; bottom: 0; width: 70vw; height: 32vw;
  pointer-events: none; z-index: 0;
}
.mountain { position: absolute; left: 0; right: 0; bottom: 0; top: 0; background: var(--accent-color); }
.mountain.far {
  opacity: .035;
  clip-path: polygon(0 100%, 17% 48%, 30% 82%, 45% 30%, 61% 79%, 76% 45%, 100% 100%);
}
.mountain.near {
  opacity: .07;
  clip-path: polygon(0 100%, 23% 65%, 40% 91%, 58% 55%, 80% 89%, 100% 72%, 100% 100%);
}

.page {
  max-width: var(--max-width, 900px);
  margin: 0 auto;
  padding: var(--page-padding, 96rpx 40rpx);
  position: relative;
  z-index: 1;
}

/* ====== 头部 logo ====== */
.header { text-align: center; margin-bottom: 16rpx; }
.site-logo { height: 104rpx; width: 190rpx; }
.subtitle {
  text-align: center;
  color: var(--subtitle-color);
  margin-bottom: 56rpx;
  font-size: 28rpx;
}

/* ====== 控制区 ====== */
.controls, .card {
  background: var(--card-bg);
  border: 2rpx solid var(--card-border);
  border-radius: 32rpx;
  box-shadow: var(--card-shadow);
}
.controls { padding: 36rpx; margin-bottom: 44rpx; }
.row { display: grid; grid-template-columns: 1fr; gap: 24rpx; margin-bottom: 28rpx; }
@media (min-width: 650px) { .row { grid-template-columns: repeat(3, 1fr); } }
.label {
  font-size: 26rpx;
  color: var(--label-color);
  margin-bottom: 12rpx;
}
/* 输入框与「卡片比例」按钮同高（72rpx） */
.input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--input-border);
  border-radius: 18rpx;
  font-size: 30rpx;
  background: var(--input-bg);
  color: var(--text-color);
}
.ph { color: var(--label-color); opacity: .6; }

/* 按钮行负边距外扩：两个主按钮比控件区更宽，向屏幕边缘靠近 */
.btn-row { margin: 0 -16rpx; }
.btn {
  width: 100%;
  border: 0;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  font-size: 32rpx;
  line-height: 1.4;
  background: var(--accent-color);
  color: var(--button-text);
  font-family: inherit;
  white-space: normal;
}
.btn-line { display: block; }
.btn[disabled] { opacity: .55; color: var(--button-text); background: var(--accent-color); }
.btn.secondary {
  background: transparent;
  color: var(--accent-color);
  border: 2rpx solid var(--accent-color);
  margin-top: 20rpx;
}
.btn.secondary[disabled] { background: transparent; color: var(--accent-color); }

/* 卡片比例选择（居中） */
.ratio-row { display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-top: 24rpx; }
.ratio-label { font-size: 26rpx; color: var(--label-color); }
/* 分段控件：胶囊轨道 + 跟随选中项平滑滑动的底色块 */
.ratio-seg { position: relative; display: flex; flex: 1; max-width: 480rpx; height: 64rpx; border-radius: 32rpx; border: 2rpx solid var(--input-border); background: var(--input-bg); }
.ratio-thumb { position: absolute; top: 4rpx; bottom: 4rpx; width: calc(25% - 8rpx); border-radius: 28rpx; background: var(--accent-color); transition: left .25s cubic-bezier(.22,.61,.36,1); }
.ratio-seg-item { position: relative; flex: 1; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: var(--text-color); opacity: .75; transition: color .2s, opacity .2s; }
.ratio-seg-item.active { color: var(--button-text); opacity: 1; }
.ratio-seg-item.disabled { opacity: .3; }

.tip {
  font-size: 26rpx;
  color: var(--tip-color);
  margin-top: 20rpx;
  line-height: 1.6;
  text-align: center;
}

/* ====== 诗词卡片 ====== */
.card {
  padding: var(--card-padding, 84rpx 56rpx);
  min-height: 720rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
/* 点缀：卡片内淡雅水印 + 内框装饰 */
.card-watermark {
  position: absolute;
  right: 4%;
  bottom: -60rpx;
  font-size: 380rpx;
  line-height: 1;
  color: var(--text-color);
  opacity: .045;
  pointer-events: none;
}
.card-frame {
  position: absolute;
  top: 28rpx; right: 28rpx; bottom: 28rpx; left: 28rpx;
  border: 2rpx solid var(--accent-color);
  border-radius: 16rpx;
  pointer-events: none;
  opacity: .22;
}
.title {
  font-size: var(--title-font-size, 72rpx);
  font-weight: 600;
  margin-bottom: 24rpx;
  max-width: 100%;
}
/* 标题换行：优先 JS 均分行，超出内框时 CSS 直接折行，绝不碰框 */
.title-line { overflow-wrap: break-word; word-break: break-all; }
/* 硬性兜底：任何文字一碰到卡片内框立即折行，绝不溢出 */
.meta {
  color: var(--meta-color);
  margin-bottom: 56rpx;
  font-size: var(--meta-font-size, 46rpx);
  white-space: nowrap;
  max-width: 100%;
}
.content {
  margin: 0 auto;
  font-size: var(--content-font-size, 52rpx);
  line-height: 2;
  text-align: center;
}
.verse-line { margin: 0; overflow-wrap: break-word; word-break: break-all; }
.verse-line.wrap { overflow-wrap: break-word; word-break: break-all; }
/* 行尾标点占零宽（悬挂标点）：居中只按文字计算，视觉对齐 */
.hang-punct { display: inline-block; width: 0; }
/* 竖排显示（设置里可选）：高度随最长句自适应，绝不截断 */
.content.vertical {
  writing-mode: vertical-rl;
  width: fit-content;
  margin: 0 auto;
  white-space: normal;
}
.content.vertical .verse-line { display: block; white-space: nowrap; }
.category {
  margin-top: 60rpx;
  overflow-wrap: break-word; word-break: break-all;
  font-size: var(--category-font-size, 40rpx);
  color: var(--category-color);
}
.status {
  padding-top: 200rpx;
  color: var(--meta-color);
  line-height: 1.8;
}
.status.error { color: var(--error-color); font-size: 32rpx; }

/* ====== 页脚 ====== */
.site-footer { margin: 84rpx auto 24rpx; text-align: center; }
.footer-logo { height: 88rpx; width: 160rpx; }
.slogan {
  margin-top: 28rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--category-color);
}
.copyright {
  margin-top: 20rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--category-color);
  opacity: .85;
}

/* ====== 开屏动画 ====== */
.splash {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
}
.splash-box { text-align: center; }
.splash-logo {
  height: 128rpx; width: 234rpx;
  animation: splashIn 1.1s cubic-bezier(.22,.61,.36,1) .1s both;
}
.splash-rule {
  width: 0; height: 2rpx; margin: 44rpx auto;
  background: var(--text-color); opacity: 0;
  animation: ruleGrow 1s ease .6s forwards;
}
.splash-motto {
  font-size: 34rpx; letter-spacing: 8rpx; color: var(--meta-color);
}
/* 座右铭逐字浮现：毛笔书写节奏，字间轻微延迟 */
.splash-motto .ch { display: inline-block; opacity: 0; transform: translateY(16rpx); animation: chIn .5s cubic-bezier(.22,.61,.36,1) forwards; animation-delay: calc(.9s + var(--i) * .11s); }
.splash-motto .ch.mid { margin: 0 8rpx; }
@keyframes chIn { to { opacity: 1; transform: none; } }
.splash-note {
  margin-top: 28rpx; font-size: 24rpx; letter-spacing: 4rpx; color: var(--category-color);
  opacity: 0; animation: fadeUp .8s ease 2.2s forwards;
}
@keyframes splashIn {
  from { opacity: 0; letter-spacing: 52rpx; }
  to { opacity: 1; letter-spacing: 20rpx; }
}
@keyframes ruleGrow { to { width: 240rpx; opacity: .4; } }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: none; }
}

/* ====== 主题切换按钮与面板 ====== */
.theme-toggle {
  /* 与网页端一致：绝对定位跟随页面滚动，不冻结在视口 */
  position: absolute;
  top: 36rpx; right: 36rpx;
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-color);
  z-index: 1200;
  opacity: 0;
  transition: opacity .5s ease;
}
.theme-toggle.ready { opacity: .8; }
/* 纯色齿轮设置图标：mask 着色跟随主题文字色；点击绕图标中心整周旋转 */
