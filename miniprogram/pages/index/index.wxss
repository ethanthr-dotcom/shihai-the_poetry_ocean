  mask: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M19.14%2012.94c.04-.3.06-.61.06-.94%200-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24%200-.43.17-.47.41l-.36%202.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47%200-.59.22L2.74%208.87c-.12.21-.08.47.12.61l2.03%201.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03%201.58c-.18.14-.23.41-.12.61l1.92%203.32c.12.22.37.29.59.22l2.39-.96c.5.38%201.03.7%201.62.94l.36%202.54c.05.24.24.41.48.41h3.84c.24%200%20.44-.17.47-.41l.36-2.54c.59-.24%201.13-.56%201.62-.94l2.39.96c.22.08.47%200%20.59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12%2015.6c-1.98%200-3.6-1.62-3.6-3.6s1.62-3.6%203.6-3.6%203.6%201.62%203.6%203.6-1.62%203.6-3.6%203.6z'/%3E%3C/svg%3E") no-repeat center / contain;
}
.theme-toggle.spin .gear-icon { animation: gearSpin .55s cubic-bezier(.22,.61,.36,1); }
@keyframes gearSpin { to { transform: rotate(360deg); } }
.theme-panel {
  position: fixed;
  top: 132rpx; right: 16rpx; left: 16rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--card-border);
  border-radius: 28rpx;
  box-shadow: var(--card-shadow);
  padding: 32rpx;
  z-index: 1199;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-16rpx) scale(.96);
  transform-origin: top right;
  transition: opacity .22s ease, transform .22s cubic-bezier(.22,.61,.36,1), visibility 0s linear .22s;
}
@media (min-width: 650px) { .theme-panel { left: auto; width: 480rpx; } }
.theme-panel.open {
  opacity: 1; visibility: visible; transform: translateY(0) scale(1);
  transition: opacity .22s ease .02s, transform .22s cubic-bezier(.22,.61,.36,1) .02s, visibility 0s;
}
.theme-section { margin-bottom: 28rpx; }
.theme-section:last-child { margin-bottom: 0; }
.theme-label {
  font-size: 24rpx;
  color: var(--label-color);
  margin-bottom: 16rpx;
  font-weight: 600;
}
.theme-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
/* 选择框统一大小：每行四个等宽，文字居中；超长标签缩小字号也不撑破 */
.theme-opt {
  flex: 0 0 calc((100% - 36rpx) / 4);
  box-sizing: border-box;
  padding: 12rpx 4rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  border: 2rpx solid var(--input-border);
  background: var(--input-bg);
  color: var(--text-color);
}
.theme-opt.long { font-size: 22rpx; }
.theme-opt.active {
  background: var(--accent-color);
  color: var(--button-text);
  border-color: var(--accent-color);
}
.panel-hint { margin-top: 20rpx; font-size: 22rpx; color: var(--meta-color); text-align: center; opacity: .75; }

/* 分享图离屏画布 */
.share-canvas {
  position: fixed;
  left: -9999px; top: 0;
  width: 10px; height: 10px;
}

/* ====== 首次使用提示 ====== */
.disclaimer {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 1000;
  display: flex; align-items: flex-end;
  background: rgba(0, 0, 0, .5);
}
/* 底部抽屉：与分享浮层同一套设计语言 */
.disclaimer-sheet {
  width: 100%;
  padding: 60rpx 56rpx calc(52rpx + env(safe-area-inset-bottom));
  background: var(--sheet-bg, var(--bg-color));
  border-top: 2rpx solid var(--accent-color);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -24rpx 80rpx rgba(0, 0, 0, .25);
  animation: sheetUp .3s ease-out;
  text-align: center;
}
.disclaimer-seal { width: 128rpx; height: 128rpx; margin: 0 auto 20rpx; }
.disclaimer-title { font-size: 36rpx; font-weight: 600; margin-bottom: 36rpx; }
.disclaimer-item { display: flex; align-items: flex-start; gap: 20rpx; text-align: left; margin-bottom: 24rpx; }
.di-ico { font-size: 36rpx; line-height: 1.5; }
.di-text { font-size: 26rpx; line-height: 1.7; color: var(--meta-color); }
.di-text .di-t { color: var(--text-color); font-weight: 600; margin-right: 12rpx; }
.disclaimer-ok { margin-top: 28rpx; }

/* ====== 开发者面板（长按齿轮 5s 呼出） ====== */
.dev-mask { position: fixed; inset: 0; z-index: 1300; display: flex; align-items: flex-end; background: rgba(0, 0, 0, .55); }
.dev-sheet {
  width: 100%; padding: 48rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--sheet-bg, var(--bg-color));
  border-top: 2rpx solid var(--accent-color); border-radius: 36rpx 36rpx 0 0;
  animation: sheetUp .3s ease-out; text-align: center;
}
.dev-title { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; }
.dev-list { max-height: 520rpx; text-align: left; margin-bottom: 20rpx; }
.dev-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 14rpx 8rpx; border-bottom: 2rpx solid var(--input-border); }
.dev-k { font-size: 26rpx; color: var(--meta-color); flex-shrink: 0; }
.dev-v { font-size: 26rpx; color: var(--text-color); text-align: right; word-break: break-all; }
.dev-btn { margin-top: 16rpx; }
/* ====== 分享浮层：底部滑出，预览图上浮出面板，圆角带阴影 ====== */
.share-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 300; display: flex; align-items: flex-end; }
.share-sheet { width: 100%; background: var(--sheet-bg, var(--card-bg)); border-top: 2rpx solid var(--card-border); border-radius: 36rpx 36rpx 0 0; padding: 0 48rpx calc(24rpx + env(safe-area-inset-bottom)); animation: sheetUp .28s ease-out; }
.share-preview { display: block; width: 68%; margin: -180rpx auto 40rpx; border-radius: 28rpx; box-shadow: 0 18rpx 48rpx rgba(0,0,0,.28); animation: previewFloat .34s ease-out; }
.share-actions { display: flex; flex-direction: column; gap: 24rpx; }
.share-opt { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; height: 92rpx; font-size: 30rpx; border-radius: 18rpx; color: var(--button-text); background: var(--accent-color); }
.share-opt .opt-ico { margin-right: 14rpx; font-size: 32rpx; line-height: 1; }
.share-opt::after { border: none; }
.share-tip { margin-top: 20rpx; text-align: center; font-size: 24rpx; opacity: .55; color: var(--text-color); }
@keyframes sheetUp { from { transform: translateY(100%); } }

@keyframes previewFloat { from { opacity: 0; transform: translateY(80rpx); } }
