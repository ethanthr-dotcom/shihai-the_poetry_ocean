/* 单页样式：镜像网页版 index.html，尺寸按 750 设计稿换算 rpx */
.app {
  min-height: 100vh;
  background: var(--bg-color, #f4f1e8);
  color: var(--text-color, #2f2a24);
  font-family: "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif;
  transition: background 0.3s, color 0.3s;
}

/* ====== 顶部加载进度条 ====== */
.progress {
  position: fixed; top: 0; left: 0; height: 6rpx; width: 0;
  background: var(--accent-color); z-index: 1001; opacity: 0;
  transition: width .35s ease, opacity .3s ease;
}
.progress.run { opacity: 1; width: 88%; transition: width 1.3s cubic-bezier(.22,.61,.36,1), opacity .2s; }
.progress.done { width: 100%; opacity: 0; transition: width .25s ease, opacity .45s ease .15s; }

/* ====== 点缀：山峦（CSS clip-path 简化版） ====== */
.deco-mountains {
  position: fixed; right: 0; bottom: 0; width: 70vw; height: 32vw;
  pointer-events: none; z-index: 0;
}
.mountain { position: absolute; left: 0; right: 0; bottom: 0; top: 0; background: var(--accent-color); }
.mountain.far {
  opacity: .035;
  clip-path: polygon(0 100%, 17% 48%, 30% 82%, 45% 30%, 61% 79%, 76% 45%, 100% 100%);
}
.mountain.near {
  opacity: .07;
  clip-path: polygon(0 100%, 23% 65%, 40% 91%, 58% 55%, 80% 89%, 100% 72%, 100% 100%);
}

.page {
  max-width: var(--max-width, 900px);
  margin: 0 auto;
  padding: var(--page-padding, 96rpx 40rpx);
  position: relative;
  z-index: 1;
}

/* ====== 头部 logo ====== */
.header { text-align: center; margin-bottom: 16rpx; }
.site-logo { height: 104rpx; width: 190rpx; }
.subtitle {
  text-align: center;
  color: var(--subtitle-color);
  margin-bottom: 56rpx;
  font-size: 28rpx;
}

/* ====== 控制区 ====== */
.controls, .card {
  background: var(--card-bg);
  border: 2rpx solid var(--card-border);
  border-radius: 32rpx;
  box-shadow: var(--card-shadow);
}
.controls { padding: 36rpx; margin-bottom: 44rpx; }
.row { display: grid; grid-template-columns: 1fr; gap: 24rpx; margin-bottom: 28rpx; }
@media (min-width: 650px) { .row { grid-template-columns: repeat(3, 1fr); } }
.label {
  font-size: 26rpx;
  color: var(--label-color);
  margin-bottom: 12rpx;
}
/* 输入框与「卡片比例」按钮同高（72rpx） */
.input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--input-border);
  border-radius: 18rpx;
  font-size: 30rpx;
  background: var(--input-bg);
  color: var(--text-color);
}
.ph { color: var(--label-color); opacity: .6; }

.btn {
  width: 100%;
  border: 0;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  font-size: 32rpx;
  line-height: 1.4;
  background: var(--accent-color);
  color: var(--button-text);
  font-family: inherit;
}
.btn[disabled] { opacity: .55; color: var(--button-text); background: var(--accent-color); }
.btn.secondary {
  background: transparent;
  color: var(--accent-color);
  border: 2rpx solid var(--accent-color);
  margin-top: 20rpx;
}
.btn.secondary[disabled] { background: transparent; color: var(--accent-color); }

/* 卡片比例选择（居中） */
.ratio-row { display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-top: 24rpx; flex-wrap: wrap; }
.ratio-label { font-size: 26rpx; color: var(--label-color); }
.ratio-opt {
  height: 72rpx; display: flex; align-items: center;
  padding: 0 24rpx; font-size: 26rpx; border-radius: 16rpx;
  border: 2rpx solid var(--input-border); background: var(--input-bg);
  color: var(--text-color);
}
.ratio-opt.active { background: var(--accent-color); color: var(--button-text); border-color: var(--accent-color); }
.ratio-opt.disabled { opacity: .45; }

.tip {
  font-size: 26rpx;
  color: var(--tip-color);
  margin-top: 20rpx;
  line-height: 1.6;
  text-align: center;
}

/* ====== 诗词卡片 ====== */
.card {
  padding: var(--card-padding, 84rpx 56rpx);
  min-height: 720rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
/* 点缀：卡片内淡雅水印 + 内框装饰 */
.card-watermark {
  position: absolute;
  right: 4%;
  bottom: -60rpx;
  font-size: 380rpx;
  line-height: 1;
  color: var(--text-color);
  opacity: .045;
  pointer-events: none;
}
.card-frame {
  position: absolute;
  top: 28rpx; right: 28rpx; bottom: 28rpx; left: 28rpx;
  border: 2rpx solid var(--accent-color);
  border-radius: 16rpx;
  pointer-events: none;
  opacity: .22;
}
.title {
  font-size: var(--title-font-size, 72rpx);
  font-weight: 600;
  margin-bottom: 24rpx;
  max-width: 100%;
}
/* 标题换行：优先 JS 均分行，超出内框时 CSS 直接折行，绝不碰框 */
.title-line { overflow-wrap: break-word; word-break: break-all; }
/* 硬性兜底：任何文字一碰到卡片内框立即折行，绝不溢出 */
.meta {
  color: var(--meta-color);
  margin-bottom: 56rpx;
  font-size: var(--meta-font-size, 46rpx);
  white-space: nowrap;
  max-width: 100%;
}
.content {
  margin: 0 auto;
  font-size: var(--content-font-size, 52rpx);
  line-height: 2;
  text-align: center;
}
.verse-line { margin: 0; overflow-wrap: break-word; word-break: break-all; }
.verse-line.wrap { overflow-wrap: break-word; word-break: break-all; }
/* 行尾标点占零宽（悬挂标点）：居中只按文字计算，视觉对齐 */
.hang-punct { display: inline-block; width: 0; }
/* 竖排显示（设置里可选）：高度随最长句自适应，绝不截断 */
.content.vertical {
  writing-mode: vertical-rl;
  width: fit-content;
  margin: 0 auto;
  white-space: normal;
}
.content.vertical .verse-line { display: block; white-space: nowrap; }
.category {
  margin-top: 60rpx;
  overflow-wrap: break-word; word-break: break-all;
  font-size: var(--category-font-size, 40rpx);
  color: var(--category-color);
}
.status {
  padding-top: 200rpx;
  color: var(--meta-color);
  line-height: 1.8;
}
.status.error { color: var(--error-color); font-size: 32rpx; }

/* ====== 页脚 ====== */
.site-footer { margin: 84rpx auto 24rpx; text-align: center; }
.footer-logo { height: 88rpx; width: 160rpx; }
.slogan {
  margin-top: 28rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--category-color);
}
.copyright {
  margin-top: 20rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--category-color);
  opacity: .85;
}

/* ====== 开屏动画 ====== */
.splash {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
}
.splash-box { text-align: center; }
.splash-logo {
  height: 128rpx; width: 234rpx;
  animation: splashIn 1.1s cubic-bezier(.22,.61,.36,1) .1s both;
}
.splash-rule {
  width: 0; height: 2rpx; margin: 44rpx auto;
  background: var(--text-color); opacity: 0;
  animation: ruleGrow 1s ease .6s forwards;
}
.splash-motto {
  font-size: 34rpx; letter-spacing: 8rpx; color: var(--meta-color);
  opacity: 0; animation: fadeUp .8s ease 1.1s forwards;
}
.splash-note {
  margin-top: 28rpx; font-size: 24rpx; letter-spacing: 4rpx; color: var(--category-color);
  opacity: 0; animation: fadeUp .8s ease 1.5s forwards;
}
@keyframes splashIn {
  from { opacity: 0; letter-spacing: 52rpx; }
  to { opacity: 1; letter-spacing: 20rpx; }
}
@keyframes ruleGrow { to { width: 240rpx; opacity: .4; } }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: none; }
}

/* ====== 主题切换按钮与面板 ====== */
.theme-toggle {
  position: fixed;
  top: 36rpx; right: 36rpx;
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-color);
  z-index: 1200;
  opacity: 0;
  transition: opacity .5s ease;
}
.theme-toggle.ready { opacity: .8; }
/* 纯色滑块设置图标（颜色跟随主题文字色） */
.slider-icon { width: 44rpx; height: 40rpx; display: flex; flex-direction: column; justify-content: space-between; }
.sl-line { position: relative; height: 4rpx; border-radius: 2rpx; background: var(--text-color); }
.sl-dot {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--text-color);
  border: 3rpx solid var(--bg-color);
}
.sl-dot.pos-a { left: 2rpx; }
.sl-dot.pos-b { right: 6rpx; }
.sl-dot.pos-c { left: 14rpx; }
.theme-panel {
  position: fixed;
  top: 132rpx; right: 16rpx; left: 16rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--card-border);
  border-radius: 28rpx;
  box-shadow: var(--card-shadow);
  padding: 32rpx;
  z-index: 1199;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-16rpx) scale(.96);
  transform-origin: top right;
  transition: opacity .22s ease, transform .22s cubic-bezier(.22,.61,.36,1), visibility 0s linear .22s;
}
@media (min-width: 650px) { .theme-panel { left: auto; width: 480rpx; } }
.theme-panel.open {
  opacity: 1; visibility: visible; transform: translateY(0) scale(1);
  transition: opacity .22s ease .02s, transform .22s cubic-bezier(.22,.61,.36,1) .02s, visibility 0s;
}
.theme-section { margin-bottom: 28rpx; }
.theme-section:last-child { margin-bottom: 0; }
.theme-label {
  font-size: 24rpx;
  color: var(--label-color);
  margin-bottom: 16rpx;
  font-weight: 600;
}
.theme-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.theme-opt {
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  border: 2rpx solid var(--input-border);
  background: var(--input-bg);
  color: var(--text-color);
}
.theme-opt.active {
  background: var(--accent-color);
  color: var(--button-text);
  border-color: var(--accent-color);
}

/* 分享图离屏画布 */
.share-canvas {
  position: fixed;
  left: -9999px; top: 0;
  width: 10px; height: 10px;
}


/* ====== 首次使用提示 ====== */
.disclaimer {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 1000;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0, 0, 0, .5);
  padding: 40rpx;
}
.disclaimer-card {
  width: 100%; max-width: 620rpx;
  padding: 56rpx 48rpx;
  background: var(--bg-color);
  border: 2rpx solid var(--accent-color);
  border-radius: 28rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, .25);
}
.disclaimer-title { font-size: 36rpx; font-weight: 600; text-align: center; margin-bottom: 32rpx; }
.disclaimer-body view { font-size: 28rpx; line-height: 1.9; color: var(--meta-color); margin-bottom: 20rpx; }
.disclaimer-ok { margin-top: 32rpx; }
/* ====== 分享浮层：底部滑出，预览图上浮出面板，圆角带阴影 ====== */
.share-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 300; display: flex; align-items: flex-end; }
.share-sheet { width: 100%; background: var(--sheet-bg, var(--card-bg)); border-top: 2rpx solid var(--card-border); border-radius: 36rpx 36rpx 0 0; padding: 0 48rpx calc(24rpx + env(safe-area-inset-bottom)); animation: sheetUp .28s ease-out; }
.share-preview { display: block; width: 68%; margin: -180rpx auto 40rpx; border-radius: 28rpx; box-shadow: 0 18rpx 48rpx rgba(0,0,0,.28); animation: previewFloat .34s ease-out; }
.share-actions { display: flex; flex-direction: column; gap: 24rpx; }
.share-opt { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; height: 92rpx; font-size: 30rpx; border-radius: 18rpx; color: var(--button-text); background: var(--accent-color); }
.share-opt .opt-ico { margin-right: 14rpx; font-size: 32rpx; line-height: 1; }
.share-opt::after { border: none; }
.share-tip { margin-top: 20rpx; text-align: center; font-size: 24rpx; opacity: .55; color: var(--text-color); }
@keyframes sheetUp { from { transform: translateY(100%); } }
@keyframes previewFloat { from { opacity: 0; transform: translateY(80rpx); } }
